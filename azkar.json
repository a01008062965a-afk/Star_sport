[
{"category":"أذكار الصباح","text":"أَصْبَحْنَا وَأَصْبَحَ الْمُلْكُ لِلَّهِ وَالْحَمْدُ لِلَّهِ"},
{"category":"أذكار الصباح","text":"اللَّهُمَّ بِكَ أَصْبَحْنَا وَبِكَ أَمْسَيْنَا وَبِكَ نَحْيَا"},
{"category":"أذكار الصباح","text":"اللَّهُمَّ أَنْتَ رَبِّي لَا إِلَهَ إِلَّا أَنْتَ"},
{"category":"أذكار الصباح","text":"اللَّهُمَّ إِنِّي أَسْأَلُكَ الْعَفْوَ وَالْعَافِيَةَ"},
{"category":"أذكار الصباح","text":"بِسْمِ اللَّهِ الَّذِي لَا يَضُرُّ مَعَ اسْمِهِ شَيْءٌ"},
{"category":"أذكار الصباح","text":"رَضِيتُ بِاللَّهِ رَبًّا وَبِالْإِسْلَامِ دِينًا"},
{"category":"أذكار المساء","text":"أَمْسَيْنَا وَأَمْسَى الْمُلْكُ لِلَّهِ"},
{"category":"أذكار المساء","text":"اللَّهُمَّ بِكَ أَمْسَيْنَا وَبِكَ أَصْبَحْنَا"},
{"category":"أذكار المساء","text":"أَعُوذُ بِكَلِمَاتِ اللَّهِ التَّامَّاتِ"},
{"category":"أذكار النوم","text":"بِاسْمِكَ اللَّهُمَّ أَمُوتُ وَأَحْيَا"},
{"category":"أذكار النوم","text":"اللَّهُمَّ قِنِي عَذَابَكَ"},
{"category":"أذكار الاستيقاظ","text":"الْحَمْدُ لِلَّهِ الَّذِي أَحْيَانَا بَعْدَ مَا أَمَاتَنَا"},
{"category":"أذكار بعد الصلاة","text":"أَسْتَغْفِرُ اللَّهَ اللَّهُمَّ أَنْتَ السَّلَامُ"},
{"category":"أذكار بعد الصلاة","text":"اللَّهُمَّ أَعِنِّي عَلَى ذِكْرِكَ وَشُكْرِكَ"},
{"category":"أذكار عامة","text":"سُبْحَانَ اللَّهِ وَبِحَمْدِهِ"},
{"category":"أذكار عامة","text":"لَا حَوْلَ وَلَا قُوَّةَ إِلَّا بِاللَّهِ"},
{"category":"أذكار عامة","text":"أَسْتَغْفِرُ اللَّهَ الْعَظِيمَ وَأَتُوبُ إِلَيْهِ"},
{"category":"أذكار عامة","text":"اللَّهُمَّ صَلِّ وَسَلِّمْ عَلَى نَبِيِّنَا مُحَمَّدٍ"},
{"category":"أذكار عامة","text":"الْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ"},
{"category":"أذكار عامة","text":"بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ"}
][]
